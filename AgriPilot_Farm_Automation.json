{
 "name": "AgriPilot - AI Farm Automation",
 "nodes": [
  {
   "id": "note-overview",
   "name": "Note Overview",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    -300,
    -380
   ],
   "parameters": {
    "content": "## AgriPilot - AI Farm Automation\nLane 1: Daily 6AM weather -> irrigation plan + weather impact + pest risk -> Telegram + Sheet log\nLane 2: Soil analysis webhook -> fertilizer advice\nLane 3: Harvest log webhook -> Sheet\nLane 4: Weekly yield prediction from harvest history\nLane 5: Daily equipment maintenance reminders\nSetup: edit 'Farm Config', add credentials (OpenAI, Telegram, Google Sheets), replace YOUR_* values.\nWeather data: Open-Meteo (free, no API key).",
    "width": 620,
    "height": 230,
    "color": 4
   }
  },
  {
   "id": "openai-model",
   "name": "OpenAI Model",
   "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
   "typeVersion": 1.2,
   "position": [
    400,
    -120
   ],
   "parameters": {
    "model": {
     "__rl": true,
     "mode": "list",
     "value": "gpt-4o-mini"
    },
    "options": {
     "temperature": 0.2
    }
   }
  },
  {
   "id": "daily-6am",
   "name": "Daily 6AM",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    0
   ],
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "0 6 * * *"
      }
     ]
    }
   }
  },
  {
   "id": "farm-config",
   "name": "Farm Config",
   "type": "n8n-nodes-base.set",
   "typeVersion": 3.4,
   "position": [
    200,
    0
   ],
   "parameters": {
    "options": {},
    "assignments": {
     "assignments": [
      {
       "id": "c1",
       "name": "lat",
       "type": "number",
       "value": 0
      },
      {
       "id": "c2",
       "name": "lon",
       "type": "number",
       "value": 0
      },
      {
       "id": "c3",
       "name": "crop",
       "type": "string",
       "value": "tomato"
      },
      {
       "id": "c4",
       "name": "growth_stage",
       "type": "string",
       "value": "flowering"
      },
      {
       "id": "c5",
       "name": "soil_type",
       "type": "string",
       "value": "loam"
      },
      {
       "id": "c6",
       "name": "area_m2",
       "type": "number",
       "value": 1000
      },
      {
       "id": "c7",
       "name": "irrigation_method",
       "type": "string",
       "value": "drip"
      }
     ]
    }
   }
  },
  {
   "id": "get-weather-(open-meteo)",
   "name": "Get Weather (Open-Meteo)",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    420,
    0
   ],
   "parameters": {
    "url": "https://api.open-meteo.com/v1/forecast",
    "sendQuery": true,
    "queryParameters": {
     "parameters": [
      {
       "name": "latitude",
       "value": "={{ $json.lat }}"
      },
      {
       "name": "longitude",
       "value": "={{ $json.lon }}"
      },
      {
       "name": "daily",
       "value": "temperature_2m_max,temperature_2m_min,precipitation_sum,precipitation_probability_max,et0_fao_evapotranspiration,wind_speed_10m_max"
      },
      {
       "name": "hourly",
       "value": "relative_humidity_2m"
      },
      {
       "name": "forecast_days",
       "value": "3"
      },
      {
       "name": "timezone",
       "value": "auto"
      }
     ]
    },
    "options": {}
   }
  },
  {
   "id": "compute-farm-metrics",
   "name": "Compute Farm Metrics",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    640,
    0
   ],
   "parameters": {
    "jsCode": "const w=$json; const cfg=$('Farm Config').first().json;\nconst d=w.daily; const h=(w.hourly.relative_humidity_2m||[]).slice(0,48);\nconst avgHum=h.reduce((a,b)=>a+b,0)/(h.length||1);\nconst rain48=(d.precipitation_sum[0]||0)+(d.precipitation_sum[1]||0);\nconst et0=d.et0_fao_evapotranspiration[0]||0;\nconst tmax=Math.max(...d.temperature_2m_max), tmin=Math.min(...d.temperature_2m_min);\nconst wind=Math.max(...d.wind_speed_10m_max);\nlet pest=0; if(avgHum>80)pest+=2; else if(avgHum>70)pest+=1;\nif(tmax>=22&&tmax<=32)pest+=2; if(rain48>5)pest+=1;\nconst water_deficit=Math.max(0,et0-rain48/2);\nreturn [{json:{cfg,metrics:{rain_48h_mm:+rain48.toFixed(1),et0_today_mm:+et0.toFixed(1),water_deficit_mm:+water_deficit.toFixed(1),tmax,tmin,max_wind_kmh:wind,avg_humidity_48h:+avgHum.toFixed(0),pest_risk_score:pest,heat_stress:tmax>=35,frost_risk:tmin<=2,heavy_rain:rain48>=30,rain_prob_max:Math.max(...d.precipitation_probability_max)},daily:d.time.map((t,i)=>({date:t,tmax:d.temperature_2m_max[i],tmin:d.temperature_2m_min[i],rain:d.precipitation_sum[i]}))}}];"
   }
  },
  {
   "id": "farm-advisor-ai",
   "name": "Farm Advisor AI",
   "type": "@n8n/n8n-nodes-langchain.chainLlm",
   "typeVersion": 1.5,
   "position": [
    860,
    0
   ],
   "parameters": {
    "promptType": "define",
    "text": "=Farm: crop={{ $json.cfg.crop }}, stage={{ $json.cfg.growth_stage }}, soil={{ $json.cfg.soil_type }}, area={{ $json.cfg.area_m2 }} m2, irrigation={{ $json.cfg.irrigation_method }}\nMetrics: {{ JSON.stringify($json.metrics) }}\n3-day forecast: {{ JSON.stringify($json.daily) }}",
    "hasOutputParser": true,
    "messages": {
     "messageValues": [
      {
       "message": "You are an agronomist. From the weather metrics decide: (1) irrigation: needed (boolean), liters_per_m2, best_time, reason - use water_deficit_mm and rain_48h_mm, skip irrigation if heavy rain expected; (2) weather_risks: list of concrete risks for this crop and stage (heat, frost, wind, flooding); (3) pest: risk_level low/medium/high from pest_risk_score and humidity, likely threats, preventive actions; (4) summary: 2 sentences; (5) alert: true only if urgent action is needed today. Be specific, no generic advice."
      }
     ]
    }
   }
  },
  {
   "id": "advisor-parser",
   "name": "Advisor Parser",
   "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
   "typeVersion": 1.2,
   "position": [
    960,
    200
   ],
   "parameters": {
    "schemaType": "manual",
    "inputSchema": "{\"type\": \"object\", \"properties\": {\"irrigation\": {\"type\": \"object\", \"properties\": {\"needed\": {\"type\": \"boolean\"}, \"liters_per_m2\": {\"type\": \"number\"}, \"best_time\": {\"type\": \"string\"}, \"reason\": {\"type\": \"string\"}}}, \"weather_risks\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"pest\": {\"type\": \"object\", \"properties\": {\"risk_level\": {\"type\": \"string\"}, \"threats\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"actions\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}}, \"summary\": {\"type\": \"string\"}, \"alert\": {\"type\": \"boolean\"}}, \"required\": [\"irrigation\", \"pest\", \"summary\", \"alert\"]}"
   }
  },
  {
   "id": "format-report",
   "name": "Format Report",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    1200,
    0
   ],
   "parameters": {
    "jsCode": "const o=$json.output; const m=$('Compute Farm Metrics').first().json.metrics; const c=$('Compute Farm Metrics').first().json.cfg;\nconst i=o.irrigation||{};\nconst msg=`${o.alert?'🚨 ':'🌱 '}Farm report - ${c.crop} (${c.growth_stage})\\n\\n💧 Irrigation: ${i.needed?`YES ${i.liters_per_m2} L/m2, ${i.best_time}`:'Not needed'}\\n${i.reason||''}\\n\\n⛅ Weather: ${m.tmin}-${m.tmax}C, rain 48h ${m.rain_48h_mm} mm, humidity ${m.avg_humidity_48h}%\\n${(o.weather_risks||[]).map(r=>'- '+r).join('\\n')}\\n\\n🐛 Pest risk: ${(o.pest.risk_level||'').toUpperCase()}\\n${(o.pest.actions||[]).map(r=>'- '+r).join('\\n')}\\n\\n${o.summary}`;\nreturn [{json:{message:msg,alert:o.alert,date:new Date().toISOString().slice(0,10),crop:c.crop,irrigation_needed:i.needed,liters_per_m2:i.liters_per_m2,pest_risk:o.pest.risk_level,rain_48h:m.rain_48h_mm,tmax:m.tmax,summary:o.summary}}];"
   }
  },
