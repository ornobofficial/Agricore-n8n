   "name": "Read Harvest History",
   "type": "n8n-nodes-base.googleSheets",
   "typeVersion": 4.5,
   "position": [
    220,
    1200
   ],
   "parameters": {
    "operation": "getAll",
    "documentId": {
     "__rl": true,
     "mode": "id",
     "value": "YOUR_SHEET_ID"
    },
    "sheetName": {
