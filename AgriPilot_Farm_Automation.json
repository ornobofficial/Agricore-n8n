  {
   "id": "aggregate-yield-stats",
   "name": "Aggregate Yield Stats",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    440,
    1200
   ],
   "parameters": {
    "jsCode": "const by={};\nfor(const i of $input.all()){const r=i.json;const k=r.crop||'unknown';by[k]=by[k]||{crop:k,harvests:0,total_kg:0,total_m2:0,months:{}};\nconst q=parseFloat(r.quantity_kg)||0,a=parseFloat(r.area_m2)||0;by[k].harvests++;by[k].total_kg+=q;by[k].total_m2+=a;\nconst mo=String(r.date||'').slice(0,7);by[k].months[mo]=(by[k].months[mo]||0)+q;}\nreturn [{json:{stats:Object.values(by).map(s=>({...s,kg_per_m2:s.total_m2?+(s.total_kg/s.total_m2).toFixed(2):null}))}}];"
   }
  },
  {
   "id": "yield-predictor-ai",
   "name": "Yield Predictor AI",
   "type": "@n8n/n8n-nodes-langchain.chainLlm",
   "typeVersion": 1.5,
   "position": [
    660,
    1200
   ],
   "parameters": {
    "promptType": "define",
    "text": "=Harvest history stats: {{ JSON.stringify($json.stats) }}\nFarm config: {{ JSON.stringify($('Farm Config').first().json) }}",
    "messages": {
     "messageValues": [
      {
       "message": "You are a farm analyst. Using the harvest history, estimate the expected yield (kg) for the next harvest of each crop, with a low-high range and confidence (low/medium/high based on how many harvests exist). Explain the trend in 2 lines. If there are fewer than 3 harvests, say the estimate is weak. Never invent data. Format as a short Telegram message."
      }
     ]
    }
   }
  },
