  {
   "id": "find-due-maintenance",
   "name": "Find Due Maintenance",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    440,
    1600
   ],
   "parameters": {
    "jsCode": "const today=new Date(); const due=[];\nfor(const i of $input.all()){const r=i.json; const last=new Date(r.last_service_date); const every=parseInt(r.interval_days)||90;\nif(isNaN(last))continue; const next=new Date(last.getTime()+every*864e5); const left=Math.ceil((next-today)/864e5);\nif(left<=7)due.push({equipment:r.equipment,days_left:left,next:next.toISOString().slice(0,10)});}\nif(!due.length)return [];\ndue.sort((a,b)=>a.days_left-b.days_left);\nreturn [{json:{message:'🔧 Maintenance due\\n\\n'+due.map(d=>`- ${d.equipment}: ${d.days_left<0?Math.abs(d.days_left)+' days OVERDUE':d.days_left+' days left'} (${d.next})`).join('\\n')}}];"
   }
  },
